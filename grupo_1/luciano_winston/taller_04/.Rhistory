library(dplyr)
matematicas <- estudiantes %>% filter(programa == "Matemáticas")
matematicas <- matematicas %>% sorter(nota_final)
matematicas <- matematicas %>% sort(nota_final)
matematicas <- sort(matematicas$nota_final)
matematicas <- estudiantes %>% filter(programa == "Matemáticas")
matematicas <- sort(matematicas$nota_final)
y <- sort(matematicas$nota_final)
# Cuantiles teóricos normales
x <- qnorm(ppoints(length(y)))
matematicas <- estudiantes %>% filter(programa == "Matemáticas")
y <- sort(matematicas$nota_final)
# Cuantiles teóricos normales
x <- qnorm(ppoints(length(y)))
# Data frame para graficar
qq_data <- data.frame(
teorico = x,
observado = y
)
# QQ Plot con highcharter
highchart() %>%
hc_chart(type = "scatter") %>%
hc_title(text = "QQ-Plot - Matemáticas") %>%
hc_xAxis(title = list(text = "Cuantiles teóricos")) %>%
hc_yAxis(title = list(text = "Cuantiles observados")) %>%
hc_add_series(
data = list_parse2(qq_data),
hcaes(x = teorico, y = observado),
name = "Datos"
) %>%
hc_add_theme(hc_theme_flat())
