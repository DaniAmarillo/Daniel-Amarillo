server <- function(input, output, session) {
  
  datos_reactivos <- reactiveVal(papers_base)
  resultados_actualizacion <- reactiveVal(data.frame())
  
  filtros_aplicados <- reactiveVal(list(
    fecha = c(
      min(papers_base$publication_date, na.rm = TRUE),
      max(papers_base$publication_date, na.rm = TRUE)
    ),
    tema = "Todos",
    autor = "Todos",
    doi = "",
    palabra = ""
  ))
  
  observeEvent(input$aplicar_filtros, {
    filtros_aplicados(list(
      fecha = input$fecha,
      tema = input$tema,
      autor = input$autor,
      doi = input$doi,
      palabra = input$palabra
    ))
  })
  
  observeEvent(input$limpiar, {
    
    fecha_inicio <- min(datos_reactivos()$publication_date, na.rm = TRUE)
    fecha_fin <- max(datos_reactivos()$publication_date, na.rm = TRUE)
    
    updateDateRangeInput(
      session,
      "fecha",
      start = fecha_inicio,
      end = fecha_fin
    )
    
    updateSelectInput(session, "tema", selected = "Todos")
    updateSelectizeInput(session, "autor", selected = "Todos")
    updateTextInput(session, "doi", value = "")
    updateTextInput(session, "palabra", value = "")
    
    filtros_aplicados(list(
      fecha = c(fecha_inicio, fecha_fin),
      tema = "Todos",
      autor = "Todos",
      doi = "",
      palabra = ""
    ))
  })
  
  papers_filtrados <- reactive({
    
    datos <- datos_reactivos()
    filtros <- filtros_aplicados()
    
    if (!is.null(filtros$fecha)) {
      datos <- datos %>%
        filter(
          publication_date >= filtros$fecha[1],
          publication_date <= filtros$fecha[2]
        )
    }
    
    if (!is.null(filtros$tema) && filtros$tema != "Todos") {
      datos <- datos %>%
        filter(topic_label == filtros$tema)
    }
    
    if (!is.null(filtros$autor) && filtros$autor != "Todos") {
      datos <- datos %>%
        filter(str_detect(str_to_lower(authors_raw), str_to_lower(filtros$autor)))
    }
    
    if (!is.null(filtros$doi) && filtros$doi != "") {
      datos <- datos %>%
        filter(str_detect(str_to_lower(doi), str_to_lower(filtros$doi)))
    }
    
    if (!is.null(filtros$palabra) && filtros$palabra != "") {
      palabra <- str_to_lower(filtros$palabra)
      
      datos <- datos %>%
        filter(
          str_detect(str_to_lower(title), palabra) |
            str_detect(str_to_lower(abstract), palabra)
        )
    }
    
    datos
  })
  
  output$total_articulos <- renderText({
    nrow(papers_filtrados())
  })
  
  output$prom_autores <- renderText({
    valor <- mean(papers_filtrados()$n_authors, na.rm = TRUE)
    ifelse(is.nan(valor), "0", round(valor, 1))
  })
  
  output$prom_citas <- renderText({
    valor <- mean(papers_filtrados()$citations, na.rm = TRUE)
    ifelse(is.nan(valor), "0", round(valor, 1))
  })
  
  output$prom_referencias <- renderText({
    valor <- mean(papers_filtrados()$n_references, na.rm = TRUE)
    ifelse(is.nan(valor), "0", round(valor, 1))
  })
  
  output$articulo_mas_citado <- renderText({
    datos <- papers_filtrados()
    
    if (nrow(datos) == 0) {
      return("No hay artículos con los filtros seleccionados")
    }
    
    datos %>%
      arrange(desc(citations)) %>%
      slice(1) %>%
      pull(title)
  })
  
  output$meta_mas_citado <- renderText({
    datos <- papers_filtrados()
    
    if (nrow(datos) == 0) {
      return("")
    }
    
    articulo <- datos %>%
      arrange(desc(citations)) %>%
      slice(1)
    
    paste0(
      "Citas: ", articulo$citations,
      " · Categoría: ", articulo$topic_label,
      " · DOI: ", articulo$doi
    )
  })
  
  output$categoria_mayor <- renderText({
    datos <- papers_filtrados()
    
    if (nrow(datos) == 0) {
      return("No disponible")
    }
    
    datos %>%
      count(topic_label, name = "cantidad") %>%
      arrange(desc(cantidad)) %>%
      slice(1) %>%
      pull(topic_label)
  })
  
  output$meta_categoria_mayor <- renderText({
    datos <- papers_filtrados()
    
    if (nrow(datos) == 0) {
      return("")
    }
    
    fila <- datos %>%
      count(topic_label, name = "cantidad") %>%
      arrange(desc(cantidad)) %>%
      slice(1)
    
    paste0("Cantidad de artículos: ", fila$cantidad)
  })
  
  output$grafico_temas <- renderHighchart({
    
    datos <- papers_filtrados() %>%
      count(topic_label, name = "cantidad") %>%
      arrange(desc(cantidad))
    
    if (nrow(datos) == 0) {
      return(
        highchart() %>%
          hc_title(text = "Artículos por categoría temática") %>%
          hc_subtitle(text = "No hay datos disponibles con los filtros seleccionados")
      )
    }
    
    hchart(
      datos,
      "column",
      hcaes(x = topic_label, y = cantidad),
      name = "Artículos"
    ) %>%
      hc_title(text = "Artículos por categoría temática") %>%
      hc_subtitle(text = "Distribución de papers según clasificación temática") %>%
      hc_xAxis(title = list(text = "Categoría")) %>%
      hc_yAxis(title = list(text = "Número de artículos")) %>%
      hc_tooltip(pointFormat = "<b>{point.y}</b> artículos") %>%
      hc_colors(paleta_bdcc) %>%
      hc_plotOptions(
        column = list(
          colorByPoint = TRUE,
          borderRadius = 6
        )
      ) %>%
      hc_add_theme(hc_theme_smpl())
  })
  
  output$grafico_tiempo <- renderHighchart({
    
    datos <- papers_filtrados() %>%
      mutate(mes = floor_date(publication_date, unit = "month")) %>%
      count(mes, name = "cantidad") %>%
      arrange(mes)
    
    if (nrow(datos) == 0) {
      return(
        highchart() %>%
          hc_title(text = "Evolución temporal de publicaciones") %>%
          hc_subtitle(text = "No hay datos disponibles con los filtros seleccionados")
      )
    }
    
    hchart(
      datos,
      "line",
      hcaes(x = mes, y = cantidad),
      name = "Publicaciones"
    ) %>%
      hc_title(text = "Evolución temporal de publicaciones") %>%
      hc_subtitle(text = "Cantidad de artículos publicados por mes") %>%
      hc_xAxis(title = list(text = "Fecha"), type = "datetime") %>%
      hc_yAxis(title = list(text = "Número de artículos")) %>%
      hc_tooltip(pointFormat = "<b>{point.y}</b> publicaciones") %>%
      hc_colors(c("#2F80ED")) %>%
      hc_plotOptions(
        line = list(
          lineWidth = 4,
          marker = list(radius = 5)
        )
      ) %>%
      hc_add_theme(hc_theme_smpl())
  })
  
  output$grafico_citas <- renderHighchart({
    
    datos <- papers_filtrados() %>%
      filter(!is.na(citations))
    
    if (nrow(datos) == 0) {
      return(
        highchart() %>%
          hc_title(text = "Distribución de citas") %>%
          hc_subtitle(text = "No hay datos disponibles con los filtros seleccionados")
      )
    }
    
    hchart(
      datos$citations,
      breaks = 12,
      name = "Citas"
    ) %>%
      hc_title(text = "Distribución de citas") %>%
      hc_subtitle(text = "Frecuencia de artículos según número de citas") %>%
      hc_xAxis(title = list(text = "Número de citas")) %>%
      hc_yAxis(title = list(text = "Frecuencia")) %>%
      hc_colors(c("#27AE60")) %>%
      hc_plotOptions(
        column = list(
          borderRadius = 5
        )
      ) %>%
      hc_add_theme(hc_theme_smpl())
  })
  
  output$tabla_articulos <- renderDT({
    
    datos <- papers_filtrados() %>%
      select(
        title,
        authors_raw,
        publication_date,
        topic_label,
        doi,
        citations,
        n_references
      ) %>%
      rename(
        "Título" = title,
        "Autores" = authors_raw,
        "Fecha" = publication_date,
        "Tema" = topic_label,
        "DOI" = doi,
        "Citas" = citations,
        "Referencias" = n_references
      )
    
    datatable(
      datos,
      rownames = FALSE,
      filter = "top",
      options = list(
        pageLength = 10,
        scrollX = TRUE,
        autoWidth = TRUE,
        language = list(
          url = "//cdn.datatables.net/plug-ins/1.10.11/i18n/Spanish.json"
        )
      )
    )
  })
  
  observeEvent(input$actualizar, {
    
    anio <- input$anio_scraping
    
    mensaje <- paste0(
      "Iniciando búsqueda de artículos para el año ", anio, "...\n",
      "Conexión a la revista BDCC: pendiente de integrar.\n",
      "Comparación de DOI contra SQLite: pendiente de integrar.\n",
      "Actualización automática de la tabla papers: pendiente de integrar.\n\n",
      "Esta sección ya está lista visualmente. En el siguiente paso se conectará con el scraping real."
    )
    
    output$estado_actualizacion <- renderText({
      mensaje
    })
    
    resultados_actualizacion(
      data.frame(
        Estado = "Prueba",
        Accion = "Zona de actualización preparada",
        Detalle = paste("Año seleccionado:", anio),
        stringsAsFactors = FALSE
      )
    )
  })
  
  observeEvent(input$verificar_ultimos, {
    
    ultimos <- datos_reactivos() %>%
      arrange(desc(publication_date)) %>%
      slice(1:5) %>%
      select(
        title,
        doi,
        publication_date,
        topic_label,
        citations,
        n_references
      ) %>%
      rename(
        Titulo = title,
        DOI = doi,
        Fecha = publication_date,
        Tema = topic_label,
        Citas = citations,
        Referencias = n_references
      )
    
    resultados_actualizacion(ultimos)
    
    output$estado_actualizacion <- renderText({
      paste0(
        "Verificación local completada.\n",
        "Se consultaron los últimos 5 artículos almacenados actualmente en SQLite.\n",
        "En el siguiente paso, esta opción se conectará al scraping para validar actualizaciones reales."
      )
    })
  })
  
  output$estado_actualizacion <- renderText({
    "Presione 'Buscar nuevos artículos' o 'Verificar últimos 5' para iniciar el proceso."
  })
  
  output$tabla_actualizacion <- renderDT({
    
    datos <- resultados_actualizacion()
    
    if (nrow(datos) == 0) {
      datos <- data.frame(
        Mensaje = "Aún no se ha ejecutado ningún proceso de actualización."
      )
    }
    
    datatable(
      datos,
      rownames = FALSE,
      options = list(
        pageLength = 5,
        scrollX = TRUE,
        language = list(
          url = "//cdn.datatables.net/plug-ins/1.10.11/i18n/Spanish.json"
        )
      )
    )
  })
}

shinyApp(ui = ui, server = server)