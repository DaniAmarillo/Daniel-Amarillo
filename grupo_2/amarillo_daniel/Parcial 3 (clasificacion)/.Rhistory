frecuencias_anchas <- db_2026 %>%
count(CHAVE_FUNCIONAL, CETIPO) %>%
pivot_wider(
names_from = CETIPO,    # Cada ítem único se convierte en una columna
values_from = n,              # La celda tendrá la frecuencia
