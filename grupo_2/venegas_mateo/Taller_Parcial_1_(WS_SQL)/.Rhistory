CREATE TABLE authors (
author_id INTEGER PRIMARY KEY AUTOINCREMENT,
author_name TEXT NOT NULL UNIQUE
)
")
setwd("~/Documents/unal/2026-1/dm/talleres/dm_2016325/grupo_2/venegas_mateo/Taller_Parcial_1_(WS_SQL)")
con <- dbConnect(RSQLite::SQLite(), "revista_q1_2025.sqlite")
# TABLA 2: AUTHORS
dbExecute(con, "
CREATE TABLE authors (
author_id INTEGER PRIMARY KEY AUTOINCREMENT,
author_name TEXT NOT NULL UNIQUE
)
")
dbGetQuery(con, "SELECT paper_id FROM papers")
cat("**1. ¿Cuál es el número promedio de autores por paper?**\n\n")
dbGetQuery(con, "
SELECT
ROUND(AVG(autor_count), 2) AS Promedio_Autores
FROM (
SELECT paper_id, COUNT(author_id) AS autor_count
FROM paper_authors
GROUP BY paper_id
) AS conteo_autores
")
